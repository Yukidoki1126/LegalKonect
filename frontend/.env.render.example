# LegalKonect Frontend - Render Production Environment Variables
# These should be set in your Render Static Site under "Environment"

# ======================
# API CONFIGURATION
# ======================
# IMPORTANT: Replace with your actual Render backend URL
REACT_APP_API_URL=https://your-backend.onrender.com/api
REACT_APP_STORAGE_URL=https://your-backend.onrender.com

# ======================
# GOOGLE MAPS
# ======================
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ======================
# NOTES
# ======================
# 1. These variables are embedded at BUILD TIME, not runtime
# 2. After changing these, you must redeploy the frontend
# 3. Get Google Maps API key from: https://console.cloud.google.com
# 4. Make sure your backend URL does NOT have a trailing slash
# 5. REACT_APP_API_URL should end with /api
# 6. REACT_APP_STORAGE_URL should NOT end with /api
