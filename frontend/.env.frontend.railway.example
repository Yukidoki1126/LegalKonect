# ============================================
# Frontend Railway/Vercel Environment Configuration
# ============================================
# Set these in your frontend deployment service (Vercel, Netlify, etc.)

# ============================================
# API CONFIGURATION
# ============================================
# Your Railway backend API URL
REACT_APP_API_URL=https://your-backend.up.railway.app/api

# ============================================
# GOOGLE SERVICES
# ============================================
# Google Maps API Key (for location features)
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth Client ID (for lawyer login)
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ============================================
# PAYMENT (Optional - if using PayMongo)
# ============================================
# NOTE: System uses manual payment by default, this key is not actively used
REACT_APP_PAYMONGO_PUBLIC_KEY=pk_live_your_paymongo_public_key_here
