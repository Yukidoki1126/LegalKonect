APP_NAME=LegalKonect
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-backend-url.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Railway MySQL Database (use Railway variables)
DB_CONNECTION=mysql
DB_HOST=${MYSQLHOST}
DB_PORT=${MYSQLPORT}
DB_DATABASE=${MYSQLDATABASE}
DB_USERNAME=${MYSQLUSER}
DB_PASSWORD=${MYSQLPASSWORD}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database

# Email Configuration (Resend)
MAIL_MAILER=resend
RESEND_KEY=your_resend_api_key
MAIL_FROM_ADDRESS="noreply@legalkonect.com"
MAIL_FROM_NAME="LegalKonect"

# AWS S3 or Cloudflare R2 for Document Storage & Payment Proofs
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=legalkonect-credentials
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Frontend URL (Railway)
FRONTEND_URL=https://your-frontend-url.railway.app
SANCTUM_STATEFUL_DOMAINS=your-frontend-url.railway.app

# Google Calendar API
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-backend-url.railway.app/api/google/callback

# Google OAuth Sign-In
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# Document Encryption Key (32 characters)
ENCRYPTION_KEY=your-32-character-encryption-key

# NOTE: This system uses MANUAL PAYMENT
# Clients upload payment proof (GCash/Bank receipts)
# Lawyers confirm payments manually - No PayMongo needed!
